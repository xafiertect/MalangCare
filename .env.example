# ╔══════════════════════════════════════════════════════════════════╗
# ║           LAPOR MALANG — Environment Configuration             ║
# ╠══════════════════════════════════════════════════════════════════╣
# ║  Salin ke root proyek : cp .env.example .env                   ║
# ║  Ganti SEMUA placeholder sebelum menjalankan sistem            ║
# ╠══════════════════════════════════════════════════════════════════╣
# ║  Generate secret keys:                                         ║
# ║    JWT / random string                                         ║
# ║      node -e "console.log(require('crypto')                    ║
# ║               .randomBytes(32).toString('base64url'))"         ║
# ║    ENCRYPTION_KEY (wajib 64 char hex / 32 byte)                ║
# ║      node -e "console.log(require('crypto')                    ║
# ║               .randomBytes(32).toString('hex'))"               ║
# ╚══════════════════════════════════════════════════════════════════╝


# ─── ENVIRONMENT & PORTS ─────────────────────────────────────────────
# Nilai: development | production | test
NODE_ENV=development
PORT=5000


# ─── APPLICATION URLs ────────────────────────────────────────────────
# URL frontend yang diizinkan oleh backend (CORS & redirect OAuth).
#   Development (Docker)  : http://localhost:3001
#   Development (lokal)   : http://localhost:3000
#   Production (VPS)      : https://yourdomain.com
FRONTEND_URL=http://localhost:3001


# ─── JWT AUTHENTICATION ──────────────────────────────────────────────
# Minimal 32 karakter — gunakan nilai BERBEDA untuk JWT_SECRET
# dan JWT_REFRESH_SECRET agar token access & refresh tidak saling tukar.
JWT_SECRET=ganti_dengan_min_32_karakter_string_random_pertama
JWT_REFRESH_SECRET=ganti_dengan_min_32_karakter_string_random_kedua_berbeda
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d


# ─── DATABASE — PostgreSQL 15 ────────────────────────────────────────
# Password untuk user "lapor_user" di PostgreSQL.
# Gunakan password yang kuat (huruf besar, kecil, angka, simbol).
DB_PASSWORD=ganti_dengan_password_postgresql_yang_kuat

# Full connection string — dipakai Prisma.
# Docker Compose   : host = "postgres" (nama container)
# Lokal tanpa Docker: host = "localhost"
# Jika menggunakan .env root untuk Docker, pastikan DB_PASSWORD di atas konsisten.
DATABASE_URL=postgresql://lapor_user:ganti_dengan_password_postgresql_yang_kuat@postgres:5432/lapor_malang


# ─── CACHE & SESSION — Redis 7 ───────────────────────────────────────
# Password Redis. Nilai kosong menonaktifkan autentikasi Redis (tidak disarankan).
REDIS_PASSWORD=ganti_dengan_password_redis_yang_kuat

# Full connection URL. Format: redis://:PASSWORD@HOST:PORT
# Docker Compose   : redis://:PASSWORD@redis:6379
# Lokal tanpa Docker: redis://:PASSWORD@localhost:6379
REDIS_URL=redis://:ganti_dengan_password_redis_yang_kuat@redis:6379


# ─── OBJECT STORAGE — MinIO (S3-compatible) ──────────────────────────
# Access key = username root MinIO (min 3 karakter)
# Secret key = password root MinIO (min 8 karakter)
MINIO_ACCESS_KEY=minioadmin_lapor
MINIO_SECRET_KEY=miniosecret_lapor_pass

# Nama bucket — jangan ubah kecuali kamu juga ubah di minio-init
MINIO_BUCKET_NAME=lapor-malang

# Endpoint koneksi dari backend ke MinIO:
#   Docker Compose   : minio  (nama container, internal network)
#   Lokal tanpa Docker: localhost
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false

# URL publik MinIO yang diakses BROWSER untuk menampilkan foto.
#   Development (Docker)  : http://localhost:9000
#   Production via Nginx  : https://yourdomain.com/files
#     (Nginx memproxy /files/* → minio:9000/lapor-malang/)
MINIO_PUBLIC_URL=http://localhost:9000


# ─── ENCRYPTION — NIK AES-256-GCM ───────────────────────────────────
# Kunci enkripsi NIK warga. WAJIB tepat 64 karakter hex (= 32 byte).
# Kehilangan kunci ini berarti NIK semua warga tidak bisa didekripsi.
# Simpan nilainya di tempat yang aman (password manager / vault).
#
# Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=ganti_dengan_tepat_64_karakter_hex_hasil_generate_di_atas


# ─── EMAIL — SMTP ────────────────────────────────────────────────────
# Digunakan untuk: OTP verifikasi akun & link reset password.
#
# Gmail (paling mudah untuk development):
#   1. Aktifkan 2-Step Verification di akun Google
#   2. Buka: myaccount.google.com/apppasswords
#   3. Buat App Password → pilih "Mail" → salin 16 karakter
#   4. Gunakan 16 karakter tersebut sebagai SMTP_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=emailkamu@gmail.com
SMTP_PASS=xxxx_xxxx_xxxx_xxxx


# ─── TELEGRAM BOT ────────────────────────────────────────────────────
# Warga bisa buat laporan langsung dari Telegram tanpa buka website.
#
# Cara dapat token:
#   1. Buka Telegram → cari @BotFather
#   2. Kirim /newbot → ikuti instruksi
#   3. Salin token (format: 123456789:AAFxxx...)
#
# TELEGRAM_BOT_ACTIVE=false → fitur bot dimatikan (tidak perlu token)
TELEGRAM_BOT_TOKEN=123456789:AAFxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_BOT_ACTIVE=true


# ─── GOOGLE OAUTH ────────────────────────────────────────────────────
# Login "Masuk dengan Google" untuk warga.
#
# Cara setup:
#   1. Buka: console.cloud.google.com → APIs & Services → Credentials
#   2. Buat OAuth 2.0 Client ID (tipe: Web application)
#   3. Authorized JavaScript origins:
#        http://localhost:3001    (development)
#        https://yourdomain.com   (production)
#   4. Tidak perlu Redirect URIs (login menggunakan credential callback)
#   5. Salin Client ID dan Client Secret ke bawah
#
# Kosongkan (hapus nilai) jika tidak menggunakan fitur ini.
GOOGLE_CLIENT_ID=xxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ─── FRONTEND — Vite Environment Variables ───────────────────────────
# Variabel berawalan VITE_ diakses oleh kode React di browser.
# Di Docker Compose, variabel ini di-inject langsung via docker-compose.yml.
# Di sini diperlukan untuk:
#   - Build frontend lokal tanpa Docker (Cara B)
#   - Build production manual di luar Docker

# URL API backend — diakses dari browser warga
#   Development     : http://localhost:5000/api
#   Production      : https://yourdomain.com/api  (via Nginx)
VITE_API_URL=http://localhost:5000/api

# Google Client ID (sama dengan GOOGLE_CLIENT_ID di atas)
VITE_GOOGLE_CLIENT_ID=xxxxxxxxxxxxx.apps.googleusercontent.com

# Konfigurasi peta (default center: Kabupaten Malang)
VITE_MAP_DEFAULT_LAT=-8.1654
VITE_MAP_DEFAULT_LNG=112.6208
VITE_MAP_DEFAULT_ZOOM=11
