# ─── JWT CONFIGURATION ──────────────────────────────────────
JWT_SECRET=replace_with_min_32_characters_random_string
JWT_REFRESH_SECRET=replace_with_min_32_characters_random_string_different
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── DATABASE (PostgreSQL) ──────────────────────────────────
DB_PASSWORD=strong_postgres_password
# Database connection string used by Prisma.
# If running through Docker: 'postgres' is the container hostname.
# For local dev without Docker, change 'postgres' to 'localhost'.
DATABASE_URL=postgresql://lapor_user:replace_with_db_password@postgres:5432/lapor_malang

# ─── CACHE & SESSION (Redis) ─────────────────────────────────
REDIS_PASSWORD=strong_redis_password
REDIS_URL=redis://:replace_with_redis_password@redis:6379

# ─── OBJECT STORAGE (MinIO) ──────────────────────────────────
MINIO_ACCESS_KEY=minioadmin_access_key
MINIO_SECRET_KEY=minioadmin_secret_key_min_8_chars
MINIO_BUCKET_NAME=lapor-malang
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=http://localhost:9000

# ─── ENCRYPTION (NIK AES-256-GCM) ───────────────────────────
# Generate a secure 32-byte key in hex (64 characters).
# Command to generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace_with_64_character_hex_string

# ─── EMAIL SERVICE (SMTP for OTP & Notifications) ────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password

# ─── SYSTEM PORTS & URLS ────────────────────────────────────
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
VITE_API_URL=http://localhost:5000/api
VITE_MINIO_PUBLIC_URL=http://localhost:9000

# ─── TELEGRAM BOT ───────────────────────────────────────────
TELEGRAM_BOT_TOKEN=replace_with_telegram_bot_token
TELEGRAM_BOT_ACTIVE=true

